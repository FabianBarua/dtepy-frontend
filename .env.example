# ========================================
# CONFIGURACIÓN DEL SERVIDOR
# ========================================
# URL del backend API.
#
# Vacío (o sin definir) = mismo origen: el navegador llama a /api/... sobre el
# propio dominio del frontend. Es lo que corresponde cuando hay un proxy
# delante (el de Vite en desarrollo, o un `location /api/` de nginx).
#
# Con valor = el frontend llama directamente a ese backend. En ese caso hay que
# habilitar el origen del frontend en el backend, con CORS_ORIGINS.
#
# Esto es un valor de COMPILACIÓN: queda dentro del build. Para cambiar el
# backend sin recompilar, editá `config.js` (queda en `dist/config.js`), o
# configuralo desde la propia app: botón "Servidor" en el login o en la barra
# superior (se guarda en el navegador y le gana a todo lo demás).
VITE_API_BASE_URL=

# Backend al que apunta el proxy de desarrollo cuando se trabaja en modo
# "mismo origen". Solo aplica a `npm run dev` / `npm run preview`.
VITE_DEV_PROXY_TARGET=http://localhost:8081

# Puerto del servidor de desarrollo (Vite)
PORT=3000

# Ruta base si la app no se sirve desde la raíz del dominio (ej: /panel/)
# VITE_BASE_PATH=/

# Modo (development, production)
NODE_ENV=development

# ========================================
# OPCIONAL: Configuración de features
# ========================================
# Habilitar modo debug
# VITE_DEBUG=true

# Tema por defecto (light, dark)
# VITE_DEFAULT_THEME=light

# Tiempo de refresco de datos en ms
# VITE_REFRESH_INTERVAL=5000
